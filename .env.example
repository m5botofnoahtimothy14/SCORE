# ============================================================
# TeachCross — Environment Variable Reference
# Copy to .env.local (admin) / supabase functions secrets as needed.
# NEVER commit filled values. NEVER expose service-role keys to clients.
# ============================================================

# ── Supabase (shared) ──────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # SERVER ONLY (edge fns, admin API routes)

# ── Admin DMS (apps/admin/.env.local) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY as above (server-only API routes)

# ── Edge Functions secrets (supabase secrets set ...) ──────
INTERNAL_WEBHOOK_SECRET=generate-a-long-random-string   # guards moderate-*/dispatch webhooks
OPENAI_API_KEY=sk-...                                   # text moderation (required for auto-approve)
GOOGLE_CLOUD_VISION_API_KEY=AIza...                     # image safety (required for auto-approve)
FCM_PROJECT_ID=your-firebase-project-id                 # push dispatch
FCM_SERVER_KEY=...                                      # FCM HTTP v1 access token / server key
MSG91_AUTH_KEY=...                                      # India SMS OTP (primary)
MSG91_OTP_TEMPLATE_ID=...                               # DLT-approved OTP template id
TWILIO_ACCOUNT_SID=AC...                                # SMS fallback
TWILIO_AUTH_TOKEN=...                                   # SMS fallback
TWILIO_FROM_NUMBER=+1...                                # SMS fallback sender

# ── Mobile build-time (--dart-define) ──────────────────────
# SUPABASE_URL, SUPABASE_ANON_KEY (same values as above, anon key only)

# ── Bootstrap (one-time, then disable) ─────────────────────
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=owner@example.edu
BOOTSTRAP_ADMIN_PASSWORD=use-a-strong-generated-password
BOOTSTRAP_SCHOOL_NAME=Demo School
BOOTSTRAP_SCHOOL_CODE=DEMO
